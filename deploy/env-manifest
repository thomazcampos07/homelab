# De onde vem cada variavel dos .env no Pi. Fonte unica: o CI gera .env
# ficticios a partir daqui e o deploy monta os .env reais com os secrets do
# Environment "production" do GitHub.
#
# Chave que existir no .env do Pi e faltar aqui SOME no proximo deploy.
#
# servico   chave_no_env        secret_no_github
pihole      PIHOLE_PASSWORD     PIHOLE_PASSWORD
wireguard   DUCKDNS_SUBDOMAIN   DUCKDNS_SUBDOMAIN
wireguard   DUCKDNS_TOKEN       DUCKDNS_TOKEN
wireguard   DDNS_DOMAIN         DDNS_DOMAIN
wireguard   WG_PEERS            WG_PEERS
beszel      BESZEL_KEY          BESZEL_KEY
beszel      HC_PING_URL         BESZEL_HC_PING_URL
backup      HC_PING_URL         BACKUP_HC_PING_URL
